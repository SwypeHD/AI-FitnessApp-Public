# Copy to .env and fill in your values.
# All variables are prefixed with FITNESS_.

# Where meal/exercise data is stored (default: data)
FITNESS_DATA_DIR=data

# LLM provider: "none" | "ollama" | "anthropic"
FITNESS_LLM_PROVIDER=none

# --- Ollama (local) ---
FITNESS_OLLAMA_HOST=http://localhost:11434
FITNESS_OLLAMA_MODEL=gemma4:26b

# --- Anthropic (cloud) ---
FITNESS_ANTHROPIC_API_KEY=
FITNESS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Shared secret required on API requests. Leave empty to disable auth
# (the default), which is what local development and the tests expect.
FITNESS_AUTH_TOKEN=
